{
  "name": "zenplex",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "ZenPlex Phase 4 streaming and playlist preview",
  "main": "dist-desktop/apps/desktop/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.desktop.json",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build",
    "package:win": "npm run native:doctor && npm run build && electron-builder --win nsis --x64",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "native:doctor": "node scripts/native-doctor.mjs",
    "native:install": "node scripts/install-native.mjs",
    "native:build": "powershell -NoProfile -File scripts/build-native.ps1",
    "test:native": "npm run build && electron tests/windows/native-smoke.mjs"
  },
  "build": {
    "appId": "app.zenplex.player",
    "productName": "ZenPlex",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/zenplex.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "native/player-host/out",
        "to": "native",
        "filter": [
          "*.exe",
          "*.dll",
          "input.conf",
          "runtime-manifest.json"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "docs/licenses",
        "to": "licenses"
      }
    ]
  },
  "dependencies": {
    "dashjs": "5.2.1",
    "hls.js": "1.7.3",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
